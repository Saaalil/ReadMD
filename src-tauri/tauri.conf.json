{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "readmd",
  "version": "0.3.2",
  "identifier": "app.readmd.desktop",
  "build": {
    "beforeDevCommand": "node scripts/frontend.mjs dev",
    "beforeBuildCommand": "node scripts/frontend.mjs build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "readmd",
        "width": 1280,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com; frame-src 'self' blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "readmd",
    "category": "Productivity",
    "shortDescription": "Native Markdown workstation",
    "longDescription": "Open, edit, render, and export Markdown and text files locally.",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkdn", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "HTML document",
        "mimeType": "text/html",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOENGQzQ4RTdEMUVGMTAKUldRUTc5SG5TUHlNbXIrWkhiVXBGVnk2YTN2TTdmZkl1U1hXekoyK2VxR0xYb0pwRzhNUUxOZ3UK",
      "endpoints": [
        "https://github.com/Saaalil/ReadMD/releases/latest/download/latest.json"
      ]
    }
  }
}
